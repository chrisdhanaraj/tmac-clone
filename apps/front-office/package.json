    "dotenv": "^16.5.0",
    "dotenv-cli": "^8.0.0",
    "isbot": "^5",
    "loops": "^6.0.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.9.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "use-debounce": "^10.0.6",
    "zod": "^3.25.42"
