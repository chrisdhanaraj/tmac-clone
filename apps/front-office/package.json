{
  "name": "front-office",
  "private": true,
  "type": "module",
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:push": "prisma db push",
    "db:seed": "prisma db seed",
    "db:seed-tennis-roles": "node --import tsx prisma/seed/tennis-roles.ts",
    "db:import-roster": "node --import tsx prisma/seed/tennis-profiles.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "better-auth": "^1.2.8",
    "dotenv": "^16.5.0",
    "dotenv-cli": "^8.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "^7.6.2",
    "zod": "^3.25.42"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@react-router/dev": "^7.6.2",
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^20",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "prisma": "^6.8.2",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.19.4",
    "tw-animate-css": "^1.3.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  }
}
