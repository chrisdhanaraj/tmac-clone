// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum booking_status {
  draft
  ready
  complete
  cancelled
}

enum booking_style {
  seven_days_before_8am
  two_days_before_noon
}

model booking {
  id                 String         @id @default(uuid())
  title              String
  status             booking_status @default(draft)
  date               DateTime
  booking_time_start DateTime
  booking_time_end   DateTime
  event_time_start   DateTime
  event_time_end     DateTime
  court_group        String
  luma_id            String?
  host_id            String
  host               user           @relation(fields: [host_id], references: [id])
  court_id           String
  court              court          @relation(fields: [court_id], references: [id])
}

model court_location {
  id              String  @id @default(uuid())
  name            String // e.g., "Potrero Hill"
  google_place_id String? @map("google_place_id")
  booking_url     String? @map("booking_url")

  courts court[]
}

model court {
  id               String         @id @default(uuid())
  name             String
  booking_style    booking_style
  booking_duration Int            @map("booking_duration")
  location_id      String         @map("location_id")
  location         court_location @relation(fields: [location_id], references: [id])
  bookings         booking[]
}

model user {
  id            String   @id @default(uuid())
  name          String
  first_name    String
  last_name     String
  email         String   @unique
  phone         String?
  rec_user_id   String?
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  roles    user_role[]
  bookings booking[]
  sessions session[]
  accounts account[]
}

model role {
  id   String @id @default(uuid())
  name String @unique

  users user_role[]
}

model user_role {
  user_id String @map("user_id")
  role_id String @map("role_id")

  user user @relation(fields: [user_id], references: [id])
  role role @relation(fields: [role_id], references: [id])

  @@id([user_id, role_id])
}

model session {
  id         String   @id @default(uuid())
  expires_at DateTime @map("expires_at")
  token      String   @unique
  created_at DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")
  ip_address String?  @map("ip_address")
  user_agent String?  @map("user_agent")
  user_id    String   @map("user_id")
  user       user     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model account {
  id                       String    @id @default(uuid())
  account_id               String    @map("account_id")
  provider_id              String    @map("provider_id")
  user_id                  String    @map("user_id")
  user                     user      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  access_token             String?   @map("access_token")
  refresh_token            String?   @map("refresh_token")
  id_token                 String?   @map("id_token")
  access_token_expires_at  DateTime? @map("access_token_expires_at")
  refresh_token_expires_at DateTime? @map("refresh_token_expires_at")
  scope                    String?
  password                 String?
  created_at               DateTime  @default(now()) @map("created_at")
  updated_at               DateTime  @updatedAt @map("updated_at")
}

model verification {
  id         String    @id @default(uuid())
  identifier String
  value      String
  expires_at DateTime  @map("expires_at")
  created_at DateTime? @default(now()) @map("created_at")
  updated_at DateTime? @updatedAt @map("updated_at")
}
