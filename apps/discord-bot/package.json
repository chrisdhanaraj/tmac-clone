{
  "name": "discord-bot",
  "version": "0.1.0",
  "type": "module",
  "description": "Discord bot powered by Bun + TypeScript",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "register:commands": "bun run src/registerCommands.ts",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "discord",
    "bot",
    "bun",
    "typescript"
  ],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.11.0",
  "dependencies": {
    "@discordjs/rest": "^2.3.0",
    "@tmac/shared": "workspace:*",
    "discord-api-types": "^0.37.90",
    "discord.js": "^14.24.2",
    "dotenv": "^16.4.7",
    "loops": "^6.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/bun": "^1.3.2",
    "@types/node": "^22.7.4",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.5.0",
    "prettier": "^3.6.2",
    "tsx": "^4.19.1",
    "typescript": "^5.9.3"
  }
}
